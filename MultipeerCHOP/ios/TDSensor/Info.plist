<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Multipeer(ローカルネットワーク)+ Bonjour サービス。CHOP の Service Type と一致 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Sends motion sensor data to TouchDesigner on your Mac over the local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_td-sensor._tcp</string>
        <string>_td-sensor._udp</string>
    </array>
    <!-- CoreMotion(ジャイロ・加速度) -->
    <key>NSMotionUsageDescription</key>
    <string>Uses the device motion sensors (gyroscope / accelerometer) as controller input.</string>
    <!-- スリープさせない(送信中に画面を保つ場合はコードでも制御) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
