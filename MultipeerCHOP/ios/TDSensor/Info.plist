<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 標準キー(GENERATE_INFOPLIST_FILE=NO のため必須。無いと実機インストールが
         "not a valid bundle / CFBundleIdentifier" エラーで失敗する) -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Multipeer(ローカルネットワーク)+ Bonjour サービス。CHOP の Service Type と一致 -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Sends motion sensor data to TouchDesigner on your Mac over the local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_td-sensor._tcp</string>
        <string>_td-sensor._udp</string>
    </array>
    <!-- CoreMotion(ジャイロ・加速度) -->
    <key>NSMotionUsageDescription</key>
    <string>Uses the device motion sensors (gyroscope / accelerometer) as controller input.</string>
    <!-- スリープさせない(送信中に画面を保つ場合はコードでも制御) -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
</dict>
</plist>
